# Copier ce fichier en .env et l'adapter : cp .env.example .env
# .env n'est jamais commité. En CI et en production, ces valeurs viennent des secrets GitHub.
# Les valeurs ci-dessous ne servent qu'en local : elles ne sont pas secrètes.

# --- API ---------------------------------------------------------------------

# Port HTTP de l'API.
PORT=3000

# Base PostgreSQL. Ces identifiants correspondent au conteneur Docker de développement (compose.yaml).
DATABASE_URL=postgresql://epickem:epickem@localhost:5432/epickem

# Redis : temps réel et files de tâches.
REDIS_URL=redis://localhost:6379

# --- Services Docker (compose.yaml) -----------------------------------------

# Ports exposés sur la machine. Si un port est déjà pris, changez-le ici
# et reportez-le dans DATABASE_URL ou REDIS_URL ci-dessus.
POSTGRES_PORT=5432
REDIS_PORT=6379

# Clé de signature des sessions (#17). En local, n'importe quelle chaîne longue.
# En production, générer une valeur aléatoire : node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET=dev-only-change-me-dev-only-change-me

# --- start.gg (#14) ----------------------------------------------------------

# Jeton personnel start.gg : Paramètres du compte > Developer Settings.
# Facultatif en local : sans jeton, les tests utilisent des réponses simulées.
STARTGG_API_TOKEN=

# --- Web (#16) ---------------------------------------------------------------

# Adresse de l'API vue par le navigateur.
VITE_API_URL=http://localhost:3000
