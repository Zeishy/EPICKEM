{
  "name": "@epickem/simulator",
  "version": "0.0.0",
  "private": true,
  "description": "Génère des données fictives (participants, matchs, pronostics) pour la démo et les tests de charge.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@epickem/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
