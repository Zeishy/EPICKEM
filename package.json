{
  "name": "epickem",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.12",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bootstrap": "node scripts/dev-env.mjs bootstrap",
    "dev": "node scripts/dev-env.mjs up && turbo run dev",
    "services:up": "node scripts/dev-env.mjs up",
    "services:down": "node scripts/dev-env.mjs down",
    "services:reset": "node scripts/dev-env.mjs reset",
    "services:status": "node scripts/dev-env.mjs status",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && node -e \"require('fs').rmSync('.turbo',{recursive:true,force:true})\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.2"
  }
}
